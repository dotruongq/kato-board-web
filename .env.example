# Base URL of the FastAPI service (no trailing slash).
# Local:   http://localhost:8080
# Netlify: https://pond-api-xxxxxxxx-uw.a.run.app
VITE_API_URL=http://localhost:8080

# Firebase web app config (Firebase console > Project settings > Your apps).
# These are public identifiers, not secrets; the API enforces who may sign in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Push notifications (Firebase Cloud Messaging). The VAPID key is the PUBLIC key from
# Firebase console > Project settings > Cloud Messaging > Web Push certificates.
VITE_FIREBASE_MESSAGING_SENDER_ID=744758785220
VITE_FIREBASE_VAPID_KEY=
